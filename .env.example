# Public business information. Leave unknown facts empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# A Calendly event URL. Never use a made-up event.
NEXT_PUBLIC_CALENDLY_URL=
# Optional live demonstration. Without this, explicitly labeled examples play.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Transactional email. Configure before enabling delivery.
RESEND_API_KEY=
EMAIL_FROM=
QUOTE_TO=
# Shared rate limiting for production serverless instances (Upstash REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
